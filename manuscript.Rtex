\title{How to Gain Advantages from Disagreeing with People you Know OR Disagreeing on purpose: Can planned interpersonal disagreements about the environment and health catalyze change?}
\shorttitle{Disagreeing with People you Know}

\author{Christin Scholz\textsuperscript{1},
Marte Otten\textsuperscript{2},
Hang-Yee Chan\textsuperscript{3}}
